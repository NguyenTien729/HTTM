# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Kiểm tra model hiện có tại https://docs.claude.com trước khi deploy,
# vì tên model có thể thay đổi theo thời gian.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_copilot

# --- App ---
APP_ENV=development
