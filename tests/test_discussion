async def test_write_discussion_end_to_end(client, fake_llm):
    async with __import__("app.db", fromlist=["get_pool"]).get_pool().acquire() as conn:
        pid = await insert_project(conn)
        paper_id = await insert_paper(conn, pid)
        await conn.execute(
            "INSERT INTO paper_analyses (paper_id, project_id, key_finding) VALUES ($1,$2,'f');", paper_id, pid)
        await conn.execute(
            "INSERT INTO themes (project_id, name, description, paper_ids) VALUES ($1,'T','d',$2::jsonb);",
            pid, json.dumps([paper_id]))
        gap_id = await conn.fetchval(
            "INSERT INTO gaps (project_id, gap_type, description, proposed_research_question, confirmed) "
            "VALUES ($1,'method','g','q',true) RETURNING id;", pid)
        rq_id = await conn.fetchval(
            "INSERT INTO research_questions (project_id, gap_id, rq_text, feasibility_score, feasibility_notes, "
            "novelty_score, novelty_notes, is_quantitative, hypotheses) VALUES ($1,$2,'RQ?',4,'n',3,'n',true,$3::jsonb) RETURNING id;",
            pid, gap_id, json.dumps([{"label": "H1", "statement": "s", "independent_variable": "hours", "dependent_variable": "score"}]))

    r = await client.post(f"/write/discussion/{rq_id}", json={"analysis_result": ANALYSIS})
    assert r.status_code == 200, r.text
    d = r.json()["discussion"]
    assert d["citations_used"] == [paper_id] and d["citations_invalid"] == [999]
    assert d["numbers_unverified"] == ["0.99"]
    assert d["hypothesis_assessments"][0]["verdict"] == "partially_supported"

    listed = await client.get(f"/write/discussion/project/{pid}")
    assert len(listed.json()) == 1


