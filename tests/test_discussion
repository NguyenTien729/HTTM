ANALYSIS = {
    "dataset": {"dataset_id": "o/d", "config": "default", "split": "train", "rows_analyzed": 1200, "sampled": False},
    "overview": {"rows_analyzed": 1200, "columns_count": 4, "duplicate_rows": 0, "missing_cells_total": 12,
                 "missing_by_column": [{"column": "age", "missing_count": 12, "missing_percent": 1.0}]},
    "column_summaries": {"score": {"kind": "numeric", "mean": 71.4321, "std": 9.8}},
    "correlation_pearson": {"hours": {"hours": 1.0, "score": 0.4123}, "score": {"hours": 0.4123, "score": 1.0}},
    "group_test": {"status": "ok", "tests": [{"name": "Welch t-test", "statistic": 3.21, "p_value": 0.0014}]},
    "ols_regression": None,
    "limitations": ["x"],
}


def test_top_correlations_dedupes_pairs():
    pairs = _top_correlations(ANALYSIS["correlation_pearson"])
    assert pairs == [{"var_1": "hours", "var_2": "score", "pearson_r": 0.4123}]


def test_validate_rejects_wrong_shape():
    with pytest.raises(HTTPException) as exc:
        _validate_analysis_result({"foo": 1})
    assert exc.value.status_code == 400
    _validate_analysis_result(ANALYSIS)


def test_unverified_numbers_flags_only_unknown_values():
    source = json.dumps(_compact_analysis(ANALYSIS))
    text = [
        "Điểm trung bình là 71.43 (n = 1200), tương quan r = 0.41 [12].",   # đều khớp nguồn
        "Kiểm định Welch cho p = 0.0014; năm 2023 có 3 nhóm.",              # khớp / bỏ qua năm & số nhỏ
        "Hiệu ứng lên tới 0.87 và mẫu 5400 sinh viên.",                      # số bịa
    ]
    assert _find_unverified_numbers(text, source) == ["0.87", "5400"]


